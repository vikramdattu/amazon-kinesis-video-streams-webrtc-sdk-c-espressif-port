# Copy to .env and fill in. .env is gitignored.

AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — only needed if you use STS / temporary credentials.
# AWS_SESSION_TOKEN=

# Anything unique. The KVS SDK will create the channel on first use.
KVS_CHANNEL_NAME=espressif-port-integration-test

# Master + viewer each run for this many seconds before SIGTERM.
TEST_DURATION_SEC=45

# 1=ERROR 2=WARN 3=INFO 4=DEBUG 5=VERBOSE.
AWS_KVS_LOG_LEVEL=3
