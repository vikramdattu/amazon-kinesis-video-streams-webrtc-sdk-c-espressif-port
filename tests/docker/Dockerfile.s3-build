#
# Phase 2 tier 1: build-only smoke for examples/webrtc_classic on
# ESP32-S3. Catches toolchain drift, link errors, and missing component
# deps as the SDK evolves — no QEMU run, no network. Tier 2 (QEMU boot
# under Espressif's qemu fork, with networked KVS round-trip) is a
# follow-up: the BSP-heavy webrtc_classic example has real-hardware
# init paths (camera, LCD) that don't translate to QEMU cleanly. We
# will likely point tier 2 at signaling_only or a smaller test app.
#
# Build context = espressif-port repo root, see GH workflow.

ARG IDF_TAG=release-v5.5
FROM espressif/idf:${IDF_TAG}

ENV DEBIAN_FRONTEND=noninteractive

# Build matrix uses a cached IDF clone; the espressif image already has
# the toolchain and Python deps installed.

WORKDIR /work

COPY . /work/sdk-repo/

# webrtc_classic uses dependencies.lock that pulls components via path:
# refs against KVS_SDK_PATH. Mirror what the GitLab CI does (see
# .gitlab-ci.yml).
ENV KVS_SDK_PATH=/work/sdk-repo

WORKDIR /work/sdk-repo/examples/webrtc_classic

# `idf.py build` honours sdkconfig.defaults.esp32s3 when target=esp32s3.
RUN . /opt/esp/idf/export.sh \
    && idf.py set-target esp32s3 \
    && idf.py build

# Surface the artifacts at a predictable path so CI can collect them as
# build evidence.
RUN mkdir -p /artifacts && \
    cp build/webrtc_classic.elf build/webrtc_classic.bin /artifacts/ 2>/dev/null || true

CMD ["bash", "-c", "ls -la /artifacts && echo 'esp32s3 build smoke OK'"]
