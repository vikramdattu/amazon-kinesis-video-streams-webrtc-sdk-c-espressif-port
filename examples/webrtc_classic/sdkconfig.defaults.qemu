#
# Overlay for running webrtc_classic under Espressif's QEMU fork on
# esp32s3. Used by the QEMU-based docker integration test —
# tests/docker/Dockerfile.s3-qemu and the esp32s3_qemu_test CI job.
#
# Apply via SDKCONFIG_DEFAULTS chain after sdkconfig.defaults +
# sdkconfig.defaults.esp32s3, e.g. by exporting
# SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.qemu"
# before `idf.py build`.

# SPIRAM is REQUIRED — KVS WebRTC peer-connection setup allocates
# MB-scale pools and OOMs without it (internal heap on S3 is ~330 KB
# free at boot, which fails STATUS_NOT_ENOUGH_MEMORY when the master
# tries to create a peer-connection session for the first viewer).
#
# QEMU's `ssi_psram` device defaults to 4 MB; we lift it to 8 MB to
# match real S3-WROOM-1U-N16R8 hardware. The size override is passed
# at QEMU launch time via:
#   -global driver=ssi_psram,property=size_mbytes,value=8
# (see tests/docker/* and the integration_test.yml workflow).
#
# Use QUAD (SPI) PSRAM, not OCT — qemu-xtensa's ssi_psram is the
# simpler quad model. Real S3-WROOM uses OPI/OCT but the QEMU build
# we use can't emulate that path correctly.
#
# Use MEMMAP (default) so PSRAM is mapped into vaddr at boot and
# heap_caps_malloc(MALLOC_CAP_SPIRAM) works as on real hardware.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=n
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# USB Serial JTAG isn't emulated in qemu-xtensa; without UART console
# we get no boot output at all. Switch to UART0.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash mode: QEMU is happier with DIO than QIO at 80 MHz.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Skip the ML / camera / display init paths that touch real hardware
# QEMU doesn't emulate. The example reads these via Kconfig-controlled
# helpers; tightening these cuts down on init-time crashes.
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# Verbose runtime logging — the QEMU integration test only runs ~60s
# and the serial log is uploaded as artifact. We want detail on
# offer-processing failures (the master returns generic
# STATUS_INTERNAL_ERROR 0xc when SDP parse / codec match fails).
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL=4

# Networking: drive through the OpenCores Ethernet model that
# qemu-xtensa exposes (`-nic user,model=open_eth`) instead of WiFi.
# app_common's app_wifi_prov_init() dispatches transparently — same
# call site in webrtc_main.c, just a different transport.
CONFIG_APP_NETWORK_USE_OPENETH=y
CONFIG_APP_NETWORK_PROV_BLE=n
CONFIG_ETH_USE_OPENETH=y

# Disable BLE entirely (NimBLE adds ~500 KB; we use Ethernet, no
# provisioning needed). Frees vaddr for flash mmap when PSRAM isn't
# emulated correctly under QEMU.
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=n

# Provide WiFi-style fallback creds in case the Kconfig-fallback path
# in app_wifi_prov_init() runs (it shouldn't with USE_OPENETH=y, but
# it's belt-and-braces).
CONFIG_ESP_WIFI_SSID="qemu"
CONFIG_ESP_WIFI_PASSWORD="qemu1234"

# Force small heap allocations into internal DRAM. The IDF OpenETH
# driver allocates its `emac_opencores_t` state via plain `calloc`,
# and its ISR (correctly IRAM_ATTR) dereferences `emac->rx_task_hdl`
# at every RX interrupt. If `emac` lands in PSRAM and an ISR fires
# during a flash-op cache-disable window, the load is a "cached
# memory accessed while cache disabled" → Cache Error panic.
# Setting ALWAYSINTERNAL=512 makes anything <512 B go to DRAM, which
# captures emac, mbedtls scratch, ESP-TLS session, etc.
# TODO: drop this when the IDF ETH driver explicitly allocates the
# mac state via heap_caps_*(MALLOC_CAP_INTERNAL).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# Stream H.264 frames from SPIFFS (samples/frame-*.h264) instead of
# from the camera. QEMU has no camera; the file-based capture path in
# media_stream gives the WebRTC pipeline real frames to send so the
# Python viewer can record + ffprobe-validate them.
CONFIG_APP_VIDEO_USE_FILE_FRAMES=y

# Use direct AWS access keys instead of AWS IoT Core credentials. The
# IoT Core path needs a per-device certificate + private key in
# /spiffs/certs/, which we deliberately don't ship (per-device
# secrets shouldn't be committed). CI injects the keys via a
# sdkconfig.defaults.qemu.local overlay generated from repo secrets.
CONFIG_IOT_CORE_ENABLE_CREDENTIALS=n
CONFIG_AWS_ACCESS_KEY_ID=""
CONFIG_AWS_SECRET_ACCESS_KEY=""
CONFIG_AWS_SESSION_TOKEN=""
CONFIG_AWS_DEFAULT_REGION="us-west-2"
CONFIG_AWS_KVS_CHANNEL_NAME="espressif-port-qemu-test"
