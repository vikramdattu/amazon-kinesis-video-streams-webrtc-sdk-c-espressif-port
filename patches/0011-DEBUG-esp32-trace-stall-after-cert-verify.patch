From f895e4cc8dba2761216000d0a0efd7574c1c112c Mon Sep 17 00:00:00 2001
From: Vikram <v@e>
Date: Sat, 2 May 2026 19:58:38 +0530
Subject: [PATCH] DEBUG(esp32): trace TURN/ICE/Tls/socket-read on stall after
 cert verify

---
 src/source/Ice/ConnectionListener.c         | 1 +
 src/source/Ice/IceAgent.c                   | 1 +
 src/source/Ice/TurnConnection.c             | 1 +
 src/source/Ice/TurnConnectionStateMachine.c | 2 ++
 4 files changed, 5 insertions(+)

diff --git a/src/source/Ice/ConnectionListener.c b/src/source/Ice/ConnectionListener.c
index cc1d64d45c..e1ea0b42f5 100644
--- a/src/source/Ice/ConnectionListener.c
+++ b/src/source/Ice/ConnectionListener.c
@@ -334,6 +334,7 @@ PVOID connectionListenerReceiveDataRoutine(PVOID arg)
 
                     if (canReadFd(localSocket, rfds, nfds)) {
                         iterate = TRUE;
+                        DLOGW("DBG_CL: socket %d readable, attempting recvfrom", localSocket);
                         while (iterate) {
                             readLen = recvfrom(localSocket, pConnectionListener->pBuffer, pConnectionListener->bufferLen, 0,
                                                (struct sockaddr*) &srcAddrBuff, &srcAddrBuffLen);
diff --git a/src/source/Ice/IceAgent.c b/src/source/Ice/IceAgent.c
index 917f79eca3..b6493a2bc8 100644
--- a/src/source/Ice/IceAgent.c
+++ b/src/source/Ice/IceAgent.c
@@ -1420,6 +1420,7 @@ STATUS iceAgentStateTransitionTimerCallback(UINT32 timerId, UINT64 currentTime,
     PIceAgent pIceAgent = (PIceAgent) customData;
 
     CHK(pIceAgent != NULL, STATUS_NULL_ARG);
+    DLOGW("DBG_ICE: stateTransitionTimer fired iceAgentState=%llu", (unsigned long long) pIceAgent->iceAgentState);
 
     // Do not acquire lock because from/execute methods
     // in state machine acquire lock
diff --git a/src/source/Ice/TurnConnection.c b/src/source/Ice/TurnConnection.c
index 5528e4a604..51bf490806 100644
--- a/src/source/Ice/TurnConnection.c
+++ b/src/source/Ice/TurnConnection.c
@@ -1175,6 +1175,7 @@ STATUS turnConnectionTimerCallback(UINT32 timerId, UINT64 currentTime, UINT64 cu
     BOOL locked = FALSE, stopScheduling = FALSE;
 
     CHK(pTurnConnection != NULL, STATUS_NULL_ARG);
+    DLOGW("DBG_TURN: timerCallback fired");
 
     MUTEX_LOCK(pTurnConnection->lock);
     locked = TRUE;
diff --git a/src/source/Ice/TurnConnectionStateMachine.c b/src/source/Ice/TurnConnectionStateMachine.c
index bdced3f8a1..d3dab6e998 100644
--- a/src/source/Ice/TurnConnectionStateMachine.c
+++ b/src/source/Ice/TurnConnectionStateMachine.c
@@ -104,6 +104,8 @@ STATUS stepTurnConnectionStateMachine(PTurnConnection pTurnConnection)
             CHK_STATUS(stepStateMachine(pTurnConnection->pStateMachine));
         }
 
+        DLOGW("DBG_TURN: stepStateMachine entry oldState=%s newState=%s ret=0x%08x", turnConnectionGetStateStr(oldState),
+              turnConnectionGetStateStr(pTurnConnection->state), retStatus);
         if (oldState != pTurnConnection->state) {
             DLOGD("[%p] Turn connection state changed from %s to %s.", (PVOID) pTurnConnection, turnConnectionGetStateStr(oldState),
                   turnConnectionGetStateStr(pTurnConnection->state));
-- 
