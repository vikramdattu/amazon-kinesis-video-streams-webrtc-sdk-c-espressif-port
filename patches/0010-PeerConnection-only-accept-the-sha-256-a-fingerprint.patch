From eca3b30ef7594371a08dbb55db937f4f77ce2dc5 Mon Sep 17 00:00:00 2001
From: Vikram Dattu <vikram.dattu@espressif.com>
Date: Thu, 30 Apr 2026 05:37:55 +0530
Subject: [PATCH] PeerConnection: only accept the sha-256 a=fingerprint line
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Modern WebRTC stacks (e.g. aiortc) emit `a=fingerprint:` lines for
multiple hash algorithms in order — sha-256, sha-384, sha-512. The
old SDP-attribute loop here unconditionally `STRNCPY`'d each one
into `pKvsPeerConnection->remoteCertificateFingerprint`, so the last
one (sha-512) overwrote the sha-256 that
`dtlsSessionVerifyRemoteCertificateFingerprint` later compares
against. The verify call then failed with
`STATUS_SSL_REMOTE_CERTIFICATE_VERIFICATION_FAILED (0x59000003)`,
the DTLS handshake aborted, and `allocateSrtp` errored out on the
same status — no media flowed.

`dtlsCertificateFingerprint` produces a SHA-256 hex digest, so only
that algorithm's fingerprint is useful here. Filter both the
session- and media-level loops on `STRNCMP("sha-256 ", 8) == 0`
before copying. Other algorithms are silently skipped, matching the
intent of the verify call.
---
 src/source/PeerConnection/PeerConnection.c | 23 ++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/source/PeerConnection/PeerConnection.c b/src/source/PeerConnection/PeerConnection.c
index 6df1f51319..e931cfc284 100644
--- a/src/source/PeerConnection/PeerConnection.c
+++ b/src/source/PeerConnection/PeerConnection.c
@@ -1409,8 +1409,19 @@ STATUS setRemoteDescription(PRtcPeerConnection pPeerConnection, PRtcSessionDescr
 
     for (i = 0; i < pSessionDescription->sessionAttributesCount; i++) {
         if (STRCMP(pSessionDescription->sdpAttributes[i].attributeName, "fingerprint") == 0) {
-            STRNCPY(pKvsPeerConnection->remoteCertificateFingerprint, pSessionDescription->sdpAttributes[i].attributeValue + 8,
-                    CERTIFICATE_FINGERPRINT_LENGTH);
+            /* Modern peers (e.g. aiortc) emit `a=fingerprint:` lines for
+             * multiple hash algorithms in order — sha-256, sha-384,
+             * sha-512. Master computes its own SHA-256 in
+             * `dtlsCertificateFingerprint`, so only the sha-256 line is
+             * useful here. Without this guard the loop overwrites with
+             * each successive fingerprint and the sha-512 hex digest
+             * "wins" — `dtlsSessionVerifyRemoteCertificateFingerprint`
+             * then fails with `STATUS_SSL_REMOTE_CERTIFICATE_VERIFICATION_FAILED`
+             * (0x59000003). */
+            if (STRNCMP(pSessionDescription->sdpAttributes[i].attributeValue, "sha-256 ", 8) == 0) {
+                STRNCPY(pKvsPeerConnection->remoteCertificateFingerprint, pSessionDescription->sdpAttributes[i].attributeValue + 8,
+                        CERTIFICATE_FINGERPRINT_LENGTH);
+            }
         } else if (pKvsPeerConnection->isOffer && STRCMP(pSessionDescription->sdpAttributes[i].attributeName, "setup") == 0) {
             // possible values are actpass, passive and active. If the incoming SDP has active, it indicates it is taking up a client role
             // In case of actpass and passive, the other peer is taking up a server role and is waiting for incoming connection
@@ -1440,8 +1451,12 @@ STATUS setRemoteDescription(PRtcPeerConnection pPeerConnection, PRtcSessionDescr
                 // Ignore the return value, we have candidates we don't support yet like TURN
                 iceAgentAddRemoteCandidate(pKvsPeerConnection->pIceAgent, pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeValue);
             } else if (STRCMP(pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeName, "fingerprint") == 0) {
-                STRNCPY(pKvsPeerConnection->remoteCertificateFingerprint,
-                        pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeValue + 8, CERTIFICATE_FINGERPRINT_LENGTH);
+                /* Only sha-256 — see the matching session-level
+                 * fingerprint loop above for the rationale. */
+                if (STRNCMP(pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeValue, "sha-256 ", 8) == 0) {
+                    STRNCPY(pKvsPeerConnection->remoteCertificateFingerprint,
+                            pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeValue + 8, CERTIFICATE_FINGERPRINT_LENGTH);
+                }
             } else if (pKvsPeerConnection->isOffer &&
                        STRCMP(pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeName, "setup") == 0) {
                 pKvsPeerConnection->dtlsIsServer = STRCMP(pSessionDescription->mediaDescriptions[i].sdpAttributes[j].attributeValue, "active") == 0;
